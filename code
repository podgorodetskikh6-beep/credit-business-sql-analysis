select m.channel, count(distinct m.user_id) as users,
count (distinct a.application_id) as applications,
count (distinct case when a.decision='Approved' then a.application_id end) as applications_approved,
count (distinct loan_id) as loans,
ROUND (COALESCE (sum(l.issued_amount), 0),2) as total_amount,
round (COALESCE (avg (l.issued_amount), 0),2) as average_amount
from marketing_touches m
join users u
    on m.user_id = u.user_id
left join applications a
    ON m.user_id = a.user_id
left join loans l
    on a.application_id = l.application_id
where u.is_test=false
and u.is_employee=False
AND LOWER (m.campaign_name) NOT LIKE '%test%'
AND LOWER(m.campaign_name) NOT LIKE '%internal%'
group by m.channel
order by total_amount desc;

SELECT 
    a.product_type,
    COUNT(*) AS number_of_applications,
    COUNT(CASE WHEN a.decision = 'Approved' THEN 1 END) AS number_of_approved_applications,
    ROUND(100.0 * COUNT(CASE WHEN a.decision = 'Approved' THEN 1 END) / COUNT(*), 2) AS approval_rate
FROM applications a
JOIN users u ON a.user_id = u.user_id
WHERE u.is_test = FALSE 
  AND u.is_employee = FALSE
GROUP BY a.product_type
ORDER BY approval_rate DESC;

WITH loan_payment_stats AS (
    SELECT 
        loan_id,
        COUNT(*) AS total_payments,
        COUNT(CASE WHEN is_successful THEN 1 END) AS successful_payments,
        COALESCE(SUM(CASE WHEN is_successful THEN payment_amount ELSE 0 END), 0) AS total_amount_paid
    FROM payments
    GROUP BY loan_id
)
SELECT 
    a.product_type,
    COUNT(l.loan_id) AS number_of_loans,
    ROUND(AVG(COALESCE(lps.total_payments, 0)), 2) AS avg_payments_per_loan,
    ROUND(
        100.0 * SUM(COALESCE(lps.successful_payments, 0)) / 
        NULLIF(SUM(COALESCE(lps.total_payments, 0)), 0), 
        2
    ) AS successful_payments_share
FROM loans l
JOIN applications a ON l.application_id = a.application_id
JOIN users u ON a.user_id = u.user_id
LEFT JOIN loan_payment_stats lps ON l.loan_id = lps.loan_id
WHERE u.is_test = FALSE
  AND u.is_employee = FALSE
  AND l.is_restructured = FALSE
GROUP BY a.product_type
ORDER BY successful_payments_share DESC;

SELECT 
    a.product_type,
    COUNT(l.loan_id) AS number_of_loans,
    ROUND(AVG(l.days_past_due_max), 2) AS avg_days_past_due_max,
    ROUND(
        100.0 * SUM(CASE WHEN l.days_past_due_max > 10 THEN 1 ELSE 0 END) / COUNT(l.loan_id), 
        2
    ) AS share_of_bad_loans
FROM loans l
JOIN applications a ON l.application_id = a.application_id
JOIN users u ON a.user_id = u.user_id
WHERE u.is_test = FALSE
  AND u.is_employee = FALSE
  AND l.is_restructured = FALSE
GROUP BY a.product_type
ORDER BY share_of_bad_loans DESC;

WITH filtered_users AS (
    SELECT user_id
    FROM users
    WHERE is_test = FALSE AND is_employee = FALSE),
filtered_touches AS (
    SELECT
        mt.user_id,
        mt.channel,
        mt.cost
    FROM marketing_touches mt
    WHERE LOWER(mt.campaign_name) NOT LIKE '%test%'
    AND LOWER (mt.campaign_name) NOT LIKE '%internal%'),
channel_costs AS (
    SELECT
        ft.channel,
        SUM(ft.cost) AS total_marketing_cost
    FROM filtered_touches ft
    JOIN filtered_users fu
        ON ft.user_id = fu.user_id
    GROUP BY ft.channel
  ),
channel_metrics AS (
    SELECT
        ft.channel,
        COUNT (DISTINCT a.application_id) AS number_of_applications,
        COUNT (DISTINCT l.loan_id) AS number_of_issued_loans
    FROM filtered_touches ft
    INNER JOIN filtered_users fu ON ft.user_id = fu.user_id
    LEFT JOIN applications a ON ft.user_id = a.user_id
    LEFT JOIN loans l ON a.application_id = l.application_id
    GROUP BY ft.channel)
SELECT
      cc.channel,
      ROUND(COALESCE (cc.total_marketing_cost,0),2) AS total_marketing_cost, 
      number_of_applications,
      number_of_issued_loans,
      ROUND (
        COALESCE (total_marketing_cost, 0) / NULLIF (number_of_applications,0),2
      ) AS cost_per_application,
      ROUND (
        COALESCE (total_marketing_cost, 0) / NULLIF(number_of_issued_loans, 0),2
      ) AS cost_per_loan
FROM channel_costs as cc
JOIN channel_metrics cm
    ON cc.channel = cm.channel
ORDER BY cost_per_loan ASC;


WITH filtered_users AS (
  SELECT user_id
  FROM users
  WHERE is_test = FALSE AND is_employee = FALSE),
filtered_loans AS (
    SELECT
        l.loan_id,
        L.user_id,
        l.issued_amount,
        l.days_past_due_max,
        a.product_type,
        u.city
    FROM loans l
    INNER JOIN applications a ON l.application_id = a.application_id
    INNER JOIN filtered_users fu ON l.user_id = fu.user_id
    INNER JOIN users u ON l.user_id = u.user_id
    WHERE l.is_restructured = FALSE),
loan_quality AS (
      SELECT
          city,
          product_type,
          COUNT (loan_id) AS number_of_loans,
          SUM (issued_amount) AS total_loan_amount,
          ROUND (AVG (days_past_due_max), 2) AS avg_days_past_due_max,
          ROUND (100.0 * SUM(CASE WHEN days_past_due_max > 10 THEN 1 ELSE 0 END) / COUNT (loan_id),2) 
          AS share_of_bad_loans
      FROM filtered_loans
      GROUP BY city, product_type)
SELECT *
FROM loan_quality
WHERE number_of_loans >= 2
ORDER BY share_of_bad_loans DESC, avg_days_past_due_max DESC;


WITH filtered_users AS (
  SELECT user_id
  FROM users
  WHERE is_test = FALSE AND is_employee = FALSE),
filtered_touches AS (
  SELECT mt.user_id,mt.channel, mt.cost
  FROM marketing_touches mt
  WHERE LOWER(mt.campaign_name) NOT LIKE '%test%' 
    AND LOWER (mt.campaign_name) NOT LIKE'%internal%'),
channel_applications AS (
  SELECT ft.channel, ft.user_id, a.application_id, a.decision, l.loan_id, l.issued_amount, l.days_past_due_max
  FROM filtered_touches ft
  INNER JOIN filtered_users fu ON ft.user_id = fu.user_id
  LEFT JOIN applications a ON ft.user_id = a.user_id
  LEFT JOIN loans l ON a.application_id = l.application_id
      AND l.is_restructured = FALSE
),
channel_metrics AS (
  SELECT
      channel,
      COUNT (DISTINCT loan_id) AS number_of_loans,
      COALESCE( SUM(DISTINCT issued_amount),0) AS total_issued_amount,
      ROUND(
        100.0* count(DISTINCT CASE WHEN decision = 'Approved'
        THEN application_id END)
        /NULLIF(COUNT(DISTINCT application_id),0 ),
        2
      ) AS approval_rate,
      ROUND(AVG(days_past_due_max),2) as avg_days_past_due_max
  FROM channel_applications
  GROUP BY channel
)
SELECT *
FROM channel_metrics
WHERE number_of_loans > 0 
ORDER BY approval_rate DESC , avg_days_past_due_max ASC;

