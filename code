DROP TABLE IF EXISTS payments;
DROP TABLE IF EXISTS loans;
DROP TABLE IF EXISTS applications;
DROP TABLE IF EXISTS marketing_touches;
DROP TABLE IF EXISTS users;

CREATE TABLE users (
    user_id INT PRIMARY KEY,
    registration_date DATE NOT NULL,
    city VARCHAR(50) NOT NULL,
    device_type VARCHAR(20) NOT NULL,
    age INT NOT NULL,
    gender VARCHAR(10),
    is_test BOOLEAN NOT NULL DEFAULT FALSE,
    is_employee BOOLEAN NOT NULL DEFAULT FALSE
);

CREATE TABLE marketing_touches (
    touch_id INT PRIMARY KEY,
    user_id INT NOT NULL,
    touch_date DATE NOT NULL,
    channel VARCHAR(30) NOT NULL,
    campaign_name VARCHAR(100) NOT NULL,
    source_type VARCHAR(30) NOT NULL,
    cost NUMERIC(10,2) NOT NULL,
    FOREIGN KEY (user_id) REFERENCES users(user_id)
);

CREATE TABLE applications (
    application_id INT PRIMARY KEY,
    user_id INT NOT NULL,
    application_date DATE NOT NULL,
    requested_amount NUMERIC(12,2) NOT NULL,
    product_type VARCHAR(30) NOT NULL,
    term_days INT NOT NULL,
    income NUMERIC(12,2),
    employment_type VARCHAR(30),
    score INT,
    decision VARCHAR(20) NOT NULL,
    rejection_reason VARCHAR(100),
    is_repeat_client BOOLEAN NOT NULL DEFAULT FALSE,
    FOREIGN KEY (user_id) REFERENCES users(user_id)
);

CREATE TABLE loans (
    loan_id INT PRIMARY KEY,
    application_id INT NOT NULL UNIQUE,
    user_id INT NOT NULL,
    issue_date DATE NOT NULL,
    issued_amount NUMERIC(12,2) NOT NULL,
    term_days INT NOT NULL,
    interest_amount NUMERIC(12,2) NOT NULL,
    closed_date DATE,
    days_past_due_max INT NOT NULL DEFAULT 0,
    extension_count INT NOT NULL DEFAULT 0,
    is_restructured BOOLEAN NOT NULL DEFAULT FALSE,
    FOREIGN KEY (application_id) REFERENCES applications(application_id),
    FOREIGN KEY (user_id) REFERENCES users(user_id)
);

CREATE TABLE payments (
    payment_id INT PRIMARY KEY,
    loan_id INT NOT NULL,
    payment_date DATE NOT NULL,
    payment_amount NUMERIC(12,2) NOT NULL,
    payment_type VARCHAR(30) NOT NULL,
    is_successful BOOLEAN NOT NULL DEFAULT TRUE,
    FOREIGN KEY (loan_id) REFERENCES loans(loan_id)
);

